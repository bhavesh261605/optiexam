# Local prototype uses SQLite and explicitly labelled demo sessions.
# Never expose this demo server publicly. Production identity/storage is not connected.
AURA_DB_PATH=./data/aura.sqlite

# Server-only Sarvam key. Set in .env.local; never use NEXT_PUBLIC_ for secrets.
SARVAM_API_KEY=

# Optional separate Python voice service. See backend/README.md.
VOICE_SERVICE_URL=http://127.0.0.1:8001
# Generate matching server secrets with python backend/setup.py.
VOICE_JWT_SECRET=
